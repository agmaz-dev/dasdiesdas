# ---------- Pflicht ----------
DATABASE_URL="postgresql://dds:PASSWORT@localhost:5432/dasdiesdas?schema=public"
# Öffentliche Adresse der Seite (für Links in E-Mails, Sitemap, Open Graph)
APP_URL="https://dasdiesdas.de"
SITE_DOMAIN="dasdiesdas.de"
# Speicherort für hochgeladene Bilder (muss dauerhaft und beschreibbar sein)
UPLOAD_DIR="./storage/uploads"

# Admin-Konto (wird mit "npm run seed" angelegt)
ADMIN_EMAIL="admin@dasdiesdas.de"
ADMIN_PASSWORD="bitte-ein-langes-sicheres-passwort-1"

# Vorab-Prüfung neuer Anzeigen durch Admins ("true" oder "false")
LISTING_MODERATION="false"

# ---------- E-Mail (SMTP) ----------
# Ohne SMTP_HOST werden E-Mails nur im Server-Log ausgegeben (nur für Entwicklung!)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="dasdiesdas <no-reply@dasdiesdas.de>"
SUPPORT_EMAIL="support@dasdiesdas.de"
# Name und Anschrift des E-Mail-Dienstleisters (erscheint in der Datenschutzerklärung)
MAIL_PROVIDER_INFO=""

# ---------- Betreiber (Impressum & Datenschutz – Pflichtangaben!) ----------
OPERATOR_NAME=""
OPERATOR_LEGAL_FORM=""
OPERATOR_REPRESENTATIVE=""
OPERATOR_STREET=""
OPERATOR_CITY=""
OPERATOR_EMAIL=""
OPERATOR_PHONE=""
OPERATOR_REGISTER=""
OPERATOR_VAT_ID=""
OPERATOR_HOSTING=""
